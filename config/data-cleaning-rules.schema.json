{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardz.game/schemas/data-cleaning-rules-1.0.json",
  "title": "CARDZ data cleaning and normalization rules",
  "type": "object",
  "required": ["schemaVersion", "layers", "identity", "metricPolicies", "fieldPolicies", "freshness", "populationBands", "mysql"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "layers": {"type": "array", "minItems": 4, "items": {"type": "object", "required": ["id", "purpose", "storage"], "properties": {"id": {"type": "string"}, "purpose": {"type": "string"}, "storage": {"type": "string"}}}},
    "identity": {"type": "object", "required": ["tuple", "matchPolicy", "failureTarget"]},
    "metricPolicies": {"type": "object", "required": ["psa10Population", "psa10ReferencePrice", "trackedSales"]},
    "fieldPolicies": {"type": "object", "required": ["timestamps", "currency", "missingValues"]},
    "freshness": {"type": "object", "required": ["psa10Population", "psa10ReferencePrice"]},
    "populationBands": {"type": "object", "required": ["formalRanking", "preEntryRadar", "discoveryOnly"]},
    "mysql": {"type": "object", "required": ["rawPayloadStorage", "canonicalObservationRule"]}
  },
  "additionalProperties": false
}
