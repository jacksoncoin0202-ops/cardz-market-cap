{
  "schemaVersion": "3.0",
  "policyVersion": "cardz-routing-2026-07-24",
  "rules": {
    "populationAuthority": "gemrate",
    "populationTransportOrder": [
      "gemrate_direct_api",
      "gemrate_public_card_page",
      "grade10_getGradingPopulations_mirror"
    ],
    "languagePartitioning": false,
    "trackedIndexes": ["tcg", "pokemon", "one-piece"],
    "populationBands": {
      "formalRanking": {"minimumPsa10Population": 1000},
      "preEntryRadar": {"minimumExclusivePsa10Population": 970, "maximumExclusivePsa10Population": 1000},
      "discoveryOnly": {"maximumInclusivePsa10Population": 970}
    }
  },
  "storagePolicy": {
    "canonicalRankingStorageLimit": null,
    "rawPayloadPolicy": "private_pointer_only",
    "canonicalObservationRetention": "append_idempotent",
    "seedPolicy": "canonical_logical_seed_excludes_raw_payloads"
  },
  "dataCleaningPolicy": {
    "rulesPath": "config/data-cleaning-rules.json",
    "schemaPath": "config/data-cleaning-rules.schema.json",
    "manualPath": "docs/DATA_CLEANING_RULES.md"
  },
  "rankingPolicy": {
    "languagePartitioning": false,
    "canonicalMembership": "complete_eligible_rankings",
    "eligibility": "psa10_population>=1000 && canonical_identity_confirmed && fresh_psa10_reference_price",
    "preEntryPolicy": "970<psa10_population<1000; collect current POP and exact PSA 10 price for radar only; never rank or publish as formal membership",
    "indexes": [
      {"id": "tcg", "scope": ["pokemon", "one-piece"], "storageLimit": null},
      {"id": "pokemon", "scope": ["pokemon"], "storageLimit": null},
      {"id": "one-piece", "scope": ["one-piece"], "storageLimit": null}
    ]
  },
  "presentationViews": [
    {"id": "top100", "rankRange": "1-100", "description": "Public headline projection of the canonical ranking."},
    {"id": "top300", "rankRange": "1-300", "description": "Public Top 300 projection of the canonical ranking."},
    {"id": "top350", "rankRange": "1-350", "description": "Operator view containing Top 300 plus reserve50."},
    {"id": "top100_plus_200", "aliasOf": "top300", "rankRange": "1-300", "description": "Compatibility alias for ranks 1-100 leaders plus ranks 101-300 watch candidates."},
    {"id": "reserve50", "rankStart": 301, "rankEnd": 350, "description": "Private reserve projection; never emitted in a public snapshot."}
  ],
  "architecture": {
    "entrypoint": "config/data-routing.json",
    "codeIndex": {
      "tool": "@colbymchenry/codegraph",
      "database": ".codegraph/codegraph.db",
      "authority": false,
      "purpose": "Read-only AST call/import/impact index; never overrides routing, ranking, storage or work-item policy."
    },
    "nodes": [
      {"id": "discovery.candidates", "kind": "collector", "label": "Candidate discovery and radar", "refs": {"toolIds": ["grade10-bootstrap", "candidate-gemrate-backfill"], "metricIds": ["candidate_identity"]}},
      {"id": "authority.gemrate", "kind": "authority", "label": "GemRate identity and population authority", "refs": {"metricIds": ["candidate_identity", "psa10_population", "psa10_population_history", "grader_supply_psa_bgs_cgc_sgc_tag"]}},
      {"id": "transport.gemrate-direct", "kind": "transport", "label": "GemRate direct API", "refs": {"toolIds": ["gemrate-population"], "metricIds": ["psa10_population", "psa10_population_history"]}},
      {"id": "transport.gemrate-public", "kind": "transport", "label": "GemRate exact public card receipt", "refs": {"toolIds": ["candidate-gemrate-backfill"], "metricIds": ["candidate_identity", "psa10_population"]}},
      {"id": "transport.gemrate-mirror", "kind": "transport", "label": "Grade10 GemRate current-POP mirror", "refs": {"toolIds": ["grade10-bootstrap", "gemrate-population"], "metricIds": ["psa10_population"]}},
      {"id": "landing.immutable-receipts", "kind": "landing", "label": "Immutable private receipts and manifests", "refs": {"profileIds": ["full-backfill", "daily"]}},
      {"id": "normalizer.identity", "kind": "normalizer", "label": "Exact canonical printing resolver", "refs": {"toolIds": ["exact-crosswalk", "canonical-sync"], "metricIds": ["candidate_identity"]}},
      {"id": "crosswalk.provider-alias", "kind": "normalizer", "label": "Provider alias to canonical printing", "refs": {"toolIds": ["candidate-gemrate-backfill", "canonical-db"], "metricIds": ["candidate_identity"], "databaseTargets": ["catalog_source_identity", "catalog_provider_identity_alias"]}},
      {"id": "review.identity", "kind": "review_queue", "label": "Identity conflict review queue", "refs": {"metricIds": ["candidate_identity"], "databaseTargets": ["market_identity_review_queue"]}},
      {"id": "collector.snk-exact", "kind": "collector", "label": "Exact SNK PSA 10 price and trades", "refs": {"toolIds": ["snk-exact-refill", "snk-reference-price"], "metricIds": ["psa10_reference_price", "tracked_sales"]}},
      {"id": "database.canonical", "kind": "database", "label": "Canonical MySQL-compatible facts", "refs": {"consumerIds": ["canonical_mysql"], "toolIds": ["canonical-db"], "databaseTargets": ["catalog_variant", "catalog_source_identity", "catalog_provider_identity_alias", "market_grader_population_observation", "market_price_observation", "market_daily_sales_aggregate", "market_candidate_daily_snapshot", "market_index_snapshot", "market_index_constituent"]}},
      {"id": "validator.eligibility", "kind": "validator", "label": "POP, identity and price eligibility gate", "refs": {"toolIds": ["coverage-audit"], "metricIds": ["candidate_identity", "psa10_population", "psa10_reference_price", "psa10_market_cap"]}},
      {"id": "derivation.market", "kind": "derivation", "label": "Market cap, windows, sales and alerts", "refs": {"toolIds": ["ranking-derivation", "ranking-alerts"], "metricIds": ["price_change_1d_7d_30d", "psa10_market_cap", "tracked_sales"]}},
      {"id": "ranking.scopes", "kind": "derivation", "label": "Complete TCG, Pokemon and One Piece rankings", "refs": {"toolIds": ["ranking-derivation"], "metricIds": ["psa10_market_cap"]}},
      {"id": "export.views", "kind": "export", "label": "Top 100, 300, 350 and reserve projections", "refs": {"consumerIds": ["sanitized_snapshot"]}},
      {"id": "export.sanitized-snapshot", "kind": "export", "label": "Provider-safe frontend handshake", "refs": {"toolIds": ["snapshot-export"], "consumerIds": ["sanitized_snapshot"]}},
      {"id": "orchestrator.daily", "kind": "orchestrator", "label": "One Python daily control flow", "refs": {"profileIds": ["daily", "weekly-candidate-refresh", "full-backfill"]}},
      {"id": "state.last-good", "kind": "checkpoint", "label": "Atomic checkpoint and last-good generation", "refs": {"profileIds": ["daily", "export"]}},
      {"id": "index.codegraph", "kind": "code_index", "label": "Local CodeGraph SQLite index", "refs": {}}
    ],
    "edges": [
      {"id": "edge.discovery-authority", "from": "discovery.candidates", "to": "authority.gemrate", "relation": "requests_exact_identity_and_population", "required": true},
      {"id": "edge.authority-direct", "from": "authority.gemrate", "to": "transport.gemrate-direct", "relation": "preferred_transport", "required": false},
      {"id": "edge.authority-public", "from": "authority.gemrate", "to": "transport.gemrate-public", "relation": "keyless_exact_transport", "required": false},
      {"id": "edge.authority-mirror", "from": "authority.gemrate", "to": "transport.gemrate-mirror", "relation": "current_population_fallback_transport", "required": false},
      {"id": "edge.direct-landing", "from": "transport.gemrate-direct", "to": "landing.immutable-receipts", "relation": "writes_receipt", "required": false},
      {"id": "edge.public-landing", "from": "transport.gemrate-public", "to": "landing.immutable-receipts", "relation": "writes_receipt", "required": false},
      {"id": "edge.mirror-landing", "from": "transport.gemrate-mirror", "to": "landing.immutable-receipts", "relation": "writes_receipt", "required": false},
      {"id": "edge.landing-identity", "from": "landing.immutable-receipts", "to": "normalizer.identity", "relation": "normalizes", "required": true},
      {"id": "edge.identity-alias", "from": "normalizer.identity", "to": "crosswalk.provider-alias", "relation": "confirms_exact_alias", "required": true},
      {"id": "edge.identity-review", "from": "normalizer.identity", "to": "review.identity", "relation": "quarantines_conflict", "required": false},
      {"id": "edge.alias-snk", "from": "crosswalk.provider-alias", "to": "collector.snk-exact", "relation": "enables_exact_price_lookup", "required": true},
      {"id": "edge-alias-db", "from": "crosswalk.provider-alias", "to": "database.canonical", "relation": "persists_alias_evidence", "required": true},
      {"id": "edge-snk-db", "from": "collector.snk-exact", "to": "database.canonical", "relation": "writes_normalized_market_facts", "required": true},
      {"id": "edge-db-gate", "from": "database.canonical", "to": "validator.eligibility", "relation": "validates_current_facts", "required": true},
      {"id": "edge-gate-derive", "from": "validator.eligibility", "to": "derivation.market", "relation": "admits_formal_and_radar_bands", "required": true},
      {"id": "edge-derive-rank", "from": "derivation.market", "to": "ranking.scopes", "relation": "orders_eligible_market_cap", "required": true},
      {"id": "edge-rank-views", "from": "ranking.scopes", "to": "export.views", "relation": "projects_rank_ranges", "required": true},
      {"id": "edge-views-snapshot", "from": "export.views", "to": "export.sanitized-snapshot", "relation": "sanitizes_for_frontend", "required": true},
      {"id": "edge-daily-state", "from": "orchestrator.daily", "to": "state.last-good", "relation": "promotes_only_after_all_gates", "required": true},
      {"id": "edge-codegraph-orchestrator", "from": "index.codegraph", "to": "orchestrator.daily", "relation": "explains_code_impact_only", "required": false}
    ]
  },
  "workItems": [
    {"id": "P0-REGISTRY-SCHEMA", "priority": "P0", "status": "completed", "title": "Validate architecture and task references", "nodeIds": ["orchestrator.daily", "index.codegraph"], "dependsOn": [], "inputs": ["config/data-routing.json"], "outputs": ["validated architecture DAG", "validated task DAG"], "acceptance": ["unknown node, tool, metric, profile, consumer and task references fail", "dependency cycles fail"], "ownerFiles": ["pipelines/registry_lineage.py", "tests/test_registry_lineage.py"]},
    {"id": "P0-CONTROL-PLANE-NODES", "priority": "P0", "status": "completed", "title": "Define the single architecture entrypoint", "nodeIds": ["orchestrator.daily", "database.canonical", "export.sanitized-snapshot"], "dependsOn": [], "inputs": ["existing metrics, tools, profiles and presentation views"], "outputs": ["architecture nodes and edges"], "acceptance": ["config/data-routing.json is the only handwritten architecture source"], "ownerFiles": ["config/data-routing.json"]},
    {"id": "P0-TASK-BOARD-SOURCE", "priority": "P0", "status": "completed", "title": "Store bounded work items in the registry", "nodeIds": ["orchestrator.daily"], "dependsOn": ["P0-CONTROL-PLANE-NODES"], "inputs": ["backend gaps"], "outputs": ["workItems"], "acceptance": ["every work item references architecture nodes and owner files"], "ownerFiles": ["config/data-routing.json"]},
    {"id": "P0-GENERATED-DOCS", "priority": "P0", "status": "completed", "title": "Generate control-plane diagram and task board", "nodeIds": ["index.codegraph", "orchestrator.daily"], "dependsOn": ["P0-REGISTRY-SCHEMA", "P0-CONTROL-PLANE-NODES"], "inputs": ["architecture nodes, edges and workItems"], "outputs": ["generated Markdown and self-contained HTML"], "acceptance": ["generate-docs --check detects drift", "generated files are never edited manually"], "ownerFiles": ["pipelines/registry_lineage.py", "docs/generated"]},
    {"id": "P0-GRAPH-QUERY", "priority": "P0", "status": "completed", "title": "Expose node and task reverse lookup", "nodeIds": ["index.codegraph", "orchestrator.daily"], "dependsOn": ["P0-REGISTRY-SCHEMA"], "inputs": ["registry identifiers"], "outputs": ["backend explain and work-items commands"], "acceptance": ["operators can trace source to DB to snapshot without repository grep"], "ownerFiles": ["pipelines/registry_lineage.py", "pipelines/data_routing.py", "scripts/backend.py"]},
    {"id": "P0-CODEGRAPH-ADAPTER", "priority": "P0", "status": "completed", "title": "Install local AST code graph without making it authoritative", "nodeIds": ["index.codegraph"], "dependsOn": [], "inputs": ["repository code"], "outputs": [".codegraph SQLite runtime", "npm graph scripts"], "acceptance": ["graph status is healthy and one explore query returns call paths"], "ownerFiles": ["package.json", "package-lock.json", ".gitignore"]},
    {"id": "T2-GEMRATE-ALIAS-DURABILITY", "priority": "P0", "status": "completed", "title": "Persist exact GemRate aliases and exact SNK identity", "nodeIds": ["crosswalk.provider-alias", "database.canonical", "review.identity"], "dependsOn": ["P0-CONTROL-PLANE-NODES"], "inputs": ["verified GemRate identity receipts"], "outputs": ["catalog_provider_identity_alias", "SNK source identity binding"], "acceptance": ["same alias cannot rebind across canonical printings", "member and spec aliases are grader namespaced", "replay adds no duplicate association"], "ownerFiles": ["pipelines/db_runtime.py", "pipelines/migrations/010_provider_identity_alias.mysql.sql", "tests/test_db_runtime.py"]},
    {"id": "T3-GEMRATE-CANDIDATE-CLASSIFICATION", "priority": "P0", "status": "in_progress", "title": "Classify the complete candidate receipt worklist", "nodeIds": ["discovery.candidates", "transport.gemrate-public", "normalizer.identity", "review.identity"], "dependsOn": ["T2-GEMRATE-ALIAS-DURABILITY"], "inputs": ["candidate IDs", "GemRate direct or public receipts"], "outputs": ["resolved, below-threshold, unavailable and review classifications"], "acceptance": ["all candidates have one terminal classification", "no name-search result promotes identity", "failed receipt IDs remain retryable"], "ownerFiles": ["pipelines/gemrate_source.py", "pipelines/gemrate_candidate_backfill.py", "data/runtime/private-source-runs"]},
    {"id": "T4-SNK-EXACT-PRICE-HISTORY", "priority": "P0", "status": "planned", "title": "Collect exact SNK PSA 10 current and history facts", "nodeIds": ["crosswalk.provider-alias", "collector.snk-exact", "database.canonical"], "dependsOn": ["T3-GEMRATE-CANDIDATE-CLASSIFICATION"], "inputs": ["exact canonical printing and SNK item binding"], "outputs": ["daily price and tracked-sale observations"], "acceptance": ["number, language and grade mismatches are rejected", "replay is idempotent"], "ownerFiles": ["pipelines/snkrdunk_bulk.py", "pipelines/snk_market_data.py", "pipelines/source_crosswalk.py"]},
    {"id": "T5-RANKING-VIEWS", "priority": "P0", "status": "planned", "title": "Derive complete rankings and presentation views", "nodeIds": ["validator.eligibility", "derivation.market", "ranking.scopes", "export.views"], "dependsOn": ["T4-SNK-EXACT-PRICE-HISTORY"], "inputs": ["current canonical population and price facts"], "outputs": ["three complete rankings", "Top 100, 300, 350 and reserve views"], "acceptance": ["POP >=1000 only enters formal ranking", "POP 971-999 remains pre-entry", "all views are slices of one generation"], "ownerFiles": ["pipelines/ranking_derivation.py", "pipelines/canonical_public_snapshot.py"]},
    {"id": "T6-DAILY-RECOVERY", "priority": "P0", "status": "planned", "title": "Run unattended daily with atomic recovery", "nodeIds": ["orchestrator.daily", "state.last-good"], "dependsOn": ["T5-RANKING-VIEWS"], "inputs": ["validated collectors, canonical DB and exporter"], "outputs": ["daily checkpoint and last-good generation"], "acceptance": ["partial source failure never advances last-good", "Windows and Linux call the same Python command"], "ownerFiles": ["scripts/backend.py", "pipelines/run_daily.py", "docs/RUNBOOK.md"]}
  ],
  "consumers": [
    {"id": "manual_operator", "type": "manual", "entrypoint": "scripts/backend.py", "reads": ["profiles", "tools", "routes"]},
    {"id": "automated_tests", "type": "test", "entrypoint": "tests/test_data_routing.py", "reads": ["routes", "tools", "profiles"]},
    {"id": "canonical_mysql", "type": "database", "entrypoint": "pipelines/db_runtime.py", "reads": ["routes", "tools", "storagePolicy"]},
    {"id": "sanitized_snapshot", "type": "snapshot", "entrypoint": "pipelines/canonical_public_snapshot.py", "reads": ["rankingPolicy", "presentationViews", "routes"]}
  ],
  "manuals": [
    {"id": "backend-runbook", "path": "docs/RUNBOOK.md", "purpose": "operator commands, checkpoint and rollback"},
    {"id": "data-contract", "path": "docs/DATA_CONTRACT.md", "purpose": "canonical data and snapshot contract"},
    {"id": "data-cleaning-rules", "path": "docs/DATA_CLEANING_RULES.md", "purpose": "raw retention, normalization, canonical fact and derivation rules"},
    {"id": "frontend-handshake", "path": "docs/FRONTEND_HANDSHAKE.md", "purpose": "sanitized frontend fields only"},
    {"id": "aws-handoff", "path": "docs/AWS_HANDOFF.md", "purpose": "Linux/AWS restore and scheduler handoff"},
    {"id": "gemrate-source", "path": "pipelines/GEMRATE_SOURCE.md", "purpose": "GemRate authority and transports"},
    {"id": "grade10-operator", "path": "integrations/grade10/OPERATOR_GUIDE.md", "purpose": "Grade10 bootstrap and mirror operation"},
    {"id": "snk-manual", "path": "docs/SNKRDUNK_API_MANUAL.md", "purpose": "exact SNK price/history collection"}
  ],
  "tests": [
    {"id": "registry-lineage", "path": "tests/test_registry_lineage.py"},
    {"id": "candidate-backfill", "path": "tests/test_gemrate_candidate_backfill.py"},
    {"id": "gemrate-transport", "path": "tests/test_gemrate_transport.py"},
    {"id": "snk-exact-refill", "path": "tests/test_snkrdunk_bulk_refill.py"},
    {"id": "canonical-sync", "path": "tests/test_market_source_gemrate.py"},
    {"id": "ranking-derivation", "path": "tests/test_ranking_derivation.py"},
    {"id": "snapshot-export", "path": "tests/test_canonical_public_snapshot.py"},
    {"id": "ebay-normalizer", "path": "tests/test_ebay_sold_data.py"},
    {"id": "market-alerts", "path": "tests/test_market_alerts.py"},
    {"id": "coverage-audit", "path": "tests/test_data_coverage_audit.py"},
    {"id": "daily-orchestration", "path": "tests/test_run_daily_orchestration.py"}
  ],
  "toolDefaults": {
    "operatingSystems": ["windows", "linux", "aws"],
    "dependencies": ["python>=3.11", "pipelines/requirements.txt"],
    "timeoutSeconds": 1800,
    "sideEffects": "writes only private landing, canonical DB or generated snapshot according to the active profile; never deploys or pushes",
    "manualRefs": ["backend-runbook", "data-contract"],
    "testRefs": ["registry-lineage"]
  },
  "routeDefaults": {
    "normalizerTool": "canonical-sync",
    "importerTool": "canonical-db"
  },
  "tools": [
    {"id": "route-contract", "phase": "preflight", "entrypoint": "pipelines/data_routing.py", "command": ["python", "pipelines/data_routing.py"], "routeMetrics": ["candidate_identity", "psa10_population", "psa10_population_history", "psa10_reference_price", "tracked_sales", "price_change_1d_7d_30d", "psa10_market_cap", "grader_supply_psa_bgs_cgc_sgc_tag", "card_market_story", "fx_usd_display_rates"], "consumers": ["manual_operator", "automated_tests", "canonical_mysql", "sanitized_snapshot"]},
    {"id": "grade10-bootstrap", "phase": "discovery", "entrypoint": "integrations/grade10/run_service.py", "command": ["python", "integrations/grade10/run_service.py"], "routeMetrics": ["candidate_identity"], "consumers": ["manual_operator", "canonical_mysql"]},
    {"id": "candidate-gemrate-backfill", "phase": "discovery", "entrypoint": "pipelines/gemrate_candidate_backfill.py", "command": ["python", "pipelines/gemrate_candidate_backfill.py", "--resume"], "routeMetrics": ["candidate_identity", "psa10_population", "psa10_population_history", "grader_supply_psa_bgs_cgc_sgc_tag"], "consumers": ["manual_operator", "canonical_mysql"], "manualRefs": ["gemrate-source", "backend-runbook"], "testRefs": ["candidate-backfill", "gemrate-transport"], "timeoutSeconds": 14400, "sideEffects": "writes immutable private candidate receipts and a resumable exact-card worklist; keyless public collection requires the explicit --collect-public-candidates full-backfill flag; no public export"},
    {"id": "exact-crosswalk", "phase": "discovery", "entrypoint": "pipelines/source_crosswalk.py", "command": ["python", "pipelines/source_crosswalk.py"], "routeMetrics": ["candidate_identity"], "consumers": ["manual_operator", "canonical_mysql"]},
    {"id": "tracked-universe", "phase": "discovery", "entrypoint": "pipelines/tracked_universe.py", "command": ["python", "pipelines/tracked_universe.py"], "routeMetrics": ["candidate_identity"], "consumers": ["manual_operator", "canonical_mysql"], "manualRefs": ["backend-runbook"], "testRefs": ["daily-orchestration"], "sideEffects": "writes the private active-universe lock from exact crosswalk evidence; no public export"},
    {"id": "gemrate-population", "phase": "collect", "entrypoint": "pipelines/gemrate_source.py", "command": ["python", "pipelines/gemrate_source.py", "daily"], "routeMetrics": ["psa10_population", "psa10_population_history", "grader_supply_psa_bgs_cgc_sgc_tag"], "consumers": ["manual_operator", "canonical_mysql"], "manualRefs": ["gemrate-source", "backend-runbook"], "testRefs": ["gemrate-transport", "daily-orchestration"]},
    {"id": "snk-exact-refill", "phase": "collect", "entrypoint": "pipelines/snkrdunk_bulk.py", "command": ["python", "pipelines/snkrdunk_bulk.py", "--condition", "trading_card_single_psa10"], "routeMetrics": ["psa10_reference_price", "tracked_sales"], "consumers": ["manual_operator", "canonical_mysql"], "manualRefs": ["snk-manual", "backend-runbook"], "testRefs": ["snk-exact-refill"], "timeoutSeconds": 14400, "sideEffects": "writes exact-match SNK private landing only after canonical identity crosswalk"},
    {"id": "snk-reference-price", "phase": "collect", "entrypoint": "pipelines/snk_market_data.py", "command": ["python", "pipelines/snk_market_data.py"], "routeMetrics": ["psa10_reference_price", "tracked_sales"], "consumers": ["manual_operator", "canonical_mysql"], "manualRefs": ["snk-manual", "backend-runbook"], "testRefs": ["snk-exact-refill", "daily-orchestration"]},
    {"id": "ebay-sold-normalizer", "phase": "collect", "entrypoint": "pipelines/ebay_sold_data.py", "command": ["python", "pipelines/ebay_sold_data.py"], "routeMetrics": ["tracked_sales", "psa10_reference_price"], "consumers": ["manual_operator", "canonical_mysql"], "manualRefs": ["data-contract", "backend-runbook"], "testRefs": ["ebay-normalizer"]},
    {"id": "canonical-sync", "phase": "normalize", "entrypoint": "pipelines/market_source_sync.py", "command": ["python", "pipelines/market_source_sync.py"], "routeMetrics": ["candidate_identity", "psa10_population", "psa10_population_history", "psa10_reference_price", "tracked_sales", "grader_supply_psa_bgs_cgc_sgc_tag", "card_market_story"], "consumers": ["manual_operator", "canonical_mysql"], "manualRefs": ["data-contract", "backend-runbook"], "testRefs": ["canonical-sync"]},
    {"id": "canonical-db", "phase": "ingest", "entrypoint": "pipelines/db_runtime.py", "command": ["python", "pipelines/db_runtime.py"], "routeMetrics": ["candidate_identity", "psa10_population", "psa10_population_history", "psa10_reference_price", "tracked_sales", "grader_supply_psa_bgs_cgc_sgc_tag", "card_market_story", "fx_usd_display_rates"], "consumers": ["manual_operator", "canonical_mysql"], "manualRefs": ["data-contract", "backend-runbook", "aws-handoff"], "testRefs": ["canonical-sync"]},
    {"id": "ranking-derivation", "phase": "derive", "entrypoint": "pipelines/ranking_derivation.py", "command": ["python", "pipelines/ranking_derivation.py"], "routeMetrics": ["psa10_market_cap"], "consumers": ["manual_operator", "canonical_mysql", "sanitized_snapshot"], "manualRefs": ["data-contract"], "testRefs": ["ranking-derivation"]},
    {"id": "ranking-alerts", "phase": "derive", "entrypoint": "pipelines/market_alerts.py", "command": ["python", "pipelines/market_alerts.py"], "routeMetrics": ["price_change_1d_7d_30d", "psa10_market_cap"], "consumers": ["manual_operator", "canonical_mysql", "sanitized_snapshot"], "manualRefs": ["data-contract", "backend-runbook"], "testRefs": ["market-alerts"]},
    {"id": "coverage-audit", "phase": "audit", "entrypoint": "pipelines/data_coverage_audit.py", "command": ["python", "pipelines/data_coverage_audit.py"], "routeMetrics": ["candidate_identity", "psa10_population", "psa10_reference_price", "psa10_market_cap"], "consumers": ["manual_operator", "automated_tests", "canonical_mysql", "sanitized_snapshot"], "manualRefs": ["data-contract", "backend-runbook"], "testRefs": ["coverage-audit"]},
    {"id": "snapshot-export", "phase": "export", "entrypoint": "pipelines/canonical_public_snapshot.py", "command": ["python", "pipelines/canonical_public_snapshot.py"], "routeMetrics": ["psa10_population", "psa10_reference_price", "tracked_sales", "price_change_1d_7d_30d", "psa10_market_cap"], "consumers": ["manual_operator", "sanitized_snapshot"], "manualRefs": ["frontend-handshake", "data-contract"], "testRefs": ["snapshot-export"]},
    {"id": "canonical-seed", "phase": "seed", "entrypoint": "scripts/canonical_seed.py", "command": ["python", "scripts/canonical_seed.py"], "routeMetrics": [], "consumers": ["manual_operator", "canonical_mysql"]},
    {"id": "seed-restore", "phase": "restore", "entrypoint": "scripts/seed_restore.py", "command": ["python", "scripts/seed_restore.py"], "routeMetrics": [], "consumers": ["manual_operator", "canonical_mysql"]},
    {"id": "handoff-verify", "phase": "verify", "entrypoint": "scripts/verify_handoff.py", "command": ["python", "scripts/verify_handoff.py"], "routeMetrics": [], "consumers": ["manual_operator", "automated_tests"]}
  ],
  "profiles": [
    {"id": "full-backfill", "phases": [{"id": "preflight", "tools": ["route-contract"]}, {"id": "discovery", "tools": ["grade10-bootstrap", "exact-crosswalk", "tracked-universe", "candidate-gemrate-backfill"]}, {"id": "collect", "tools": ["snk-exact-refill", "gemrate-population", "snk-reference-price", "ebay-sold-normalizer"]}, {"id": "normalize", "tools": ["canonical-sync"]}, {"id": "ingest", "tools": ["canonical-db"]}, {"id": "derive", "tools": ["ranking-derivation", "ranking-alerts"]}, {"id": "audit", "tools": ["coverage-audit"]}]},
    {"id": "weekly-candidate-refresh", "phases": [{"id": "preflight", "tools": ["route-contract"]}, {"id": "discovery", "tools": ["candidate-gemrate-backfill", "exact-crosswalk"]}, {"id": "collect", "tools": ["snk-exact-refill"]}, {"id": "normalize", "tools": ["canonical-sync"]}, {"id": "ingest", "tools": ["canonical-db"]}, {"id": "derive", "tools": ["ranking-derivation", "ranking-alerts"]}, {"id": "audit", "tools": ["coverage-audit"]}]},
    {"id": "daily", "phases": [{"id": "preflight", "tools": ["route-contract"]}, {"id": "discovery", "tools": ["exact-crosswalk"]}, {"id": "collect", "tools": ["gemrate-population", "snk-reference-price", "ebay-sold-normalizer"]}, {"id": "normalize", "tools": ["canonical-sync"]}, {"id": "ingest", "tools": ["canonical-db"]}, {"id": "derive", "tools": ["ranking-derivation", "ranking-alerts"]}, {"id": "audit", "tools": ["coverage-audit"]}]},
    {"id": "export", "phases": [{"id": "audit", "tools": ["coverage-audit"]}, {"id": "export", "tools": ["snapshot-export"]}]},
    {"id": "snapshot-export", "aliasOf": "export", "phases": [{"id": "audit", "tools": ["coverage-audit"]}, {"id": "export", "tools": ["snapshot-export"]}]},
    {"id": "seed-build", "phases": [{"id": "audit", "tools": ["coverage-audit"]}, {"id": "seed", "tools": ["canonical-seed", "handoff-verify"]}]},
    {"id": "restore", "phases": [{"id": "verify", "tools": ["handoff-verify"]}, {"id": "restore", "tools": ["seed-restore"]}, {"id": "canary", "tools": ["route-contract", "coverage-audit"]}]},
    {"id": "seed-restore", "aliasOf": "restore", "phases": [{"id": "verify", "tools": ["handoff-verify"]}, {"id": "restore", "tools": ["seed-restore"]}, {"id": "canary", "tools": ["route-contract", "coverage-audit"]}]}
  ],
  "routes": [
    {
      "metric": "candidate_identity",
      "authority": "gemrate",
      "primary": "gemrate_direct_api_identity_receipt",
      "collector": "pipelines/gemrate_candidate_backfill.py --resume",
      "collectorTool": "candidate-gemrate-backfill",
      "transport": {
        "preferred": "gemrate_direct_api_identity_receipt",
        "alternates": ["gemrate_public_exact_card_page_receipt", "grade10_gemrate_mirror_identity_evidence"],
        "discoveryOnly": ["gemrate_structured_search", "gemrate_universal_search"],
        "directRoute": "/cards/{gemrate_id}/population?parsed_description=true",
        "publicCardPageRoute": "/card/{gemrate_id}",
        "mirrorRoute": "price.getGradingPopulations",
        "promotionRule": "only an exact crosswalk may confirm a canonical printing; public card_number is provider evidence and may be short or blank; mirror and discovery evidence cannot bind or rebind a canonical printing"
      },
      "secondary": ["snk_catalog_discovery"],
      "bootstrapEvidence": ["grade10_index_discovery"],
      "databaseTarget": "catalog_source_identity + catalog_provider_identity_alias + market_identity_review_queue",
      "snapshotFields": ["cards.<id>.identityStatus", "cards.<id>.collectorNumber", "cards.<id>.language", "cards.<id>.names", "cards.<id>.sets"],
      "freshnessHours": 168,
      "failureMode": "candidate_unresolved",
      "rankingRequired": true
    },
    {
      "metric": "psa10_population",
      "authority": "gemrate",
      "primary": "gemrate",
      "collector": "pipelines/gemrate_source.py daily",
      "collectorTool": "gemrate-population",
      "upstreamRoute": "/cards/{gemrate_id}/population",
      "transport": {
        "preferred": "gemrate_direct_api",
        "alternates": ["gemrate_public_card_page", "grade10_getGradingPopulations_mirror"],
        "publicCardPageRoute": "/card/{gemrate_id}",
        "deprecatedPublicCardDetailsRoute": "/card-details?gemrate_id={gemrate_id}",
        "mirrorRoute": "price.getGradingPopulations",
        "mirrorCollector": "integrations/grade10/grade10_scraper.py",
        "mirrorScope": "current population only",
        "sameDayPolicy": "require_equal_value_or_fail_run_for_direct_and_mirror",
        "differentDayPolicy": "direct_then_public_card_page_then_mirror_with_transport_provenance"
      },
      "fallback": [],
      "databaseTarget": "market_grader_population_observation",
      "snapshotFields": ["cards.<id>.populationPsa10", "cards.<id>.graderPopulations.PSA"],
      "freshnessHours": 48,
      "staleHours": 168,
      "failureMode": "exclude_from_ranking",
      "rankingRequired": true
    },
    {
      "metric": "psa10_population_history",
      "authority": "gemrate",
      "primary": "gemrate",
      "collector": "pipelines/gemrate_source.py daily",
      "collectorTool": "gemrate-population",
      "upstreamRoute": "/cards/{gemrate_id}/population/history?interval=week",
      "transport": {
        "preferred": "gemrate_direct_api",
        "alternate": null,
        "mirrorScope": "not available for historical population"
      },
      "fallback": [],
      "databaseTarget": "market_grader_population_observation",
      "snapshotFields": ["cards.<id>.graderPopulations.PSA.topGradePopulationChangePct"],
      "freshnessHours": 24,
      "failureMode": "history_accumulating",
      "rankingRequired": false
    },
    {
      "metric": "psa10_reference_price",
      "authority": "snk_exact_psa10_history",
      "primary": "snk",
      "collector": "pipelines/snk_market_data.py",
      "collectorTool": "snk-exact-refill",
      "secondary": ["ebay_psa10_sold_validation"],
      "bootstrapEvidence": ["grade10_last_good"],
      "fallback": [],
      "databaseTarget": "market_price_observation",
      "snapshotFields": ["cards.<id>.pricePsa10", "cards.<id>.historyDaily"],
      "freshnessHours": 30,
      "staleHours": 48,
      "failureMode": "exclude_from_ranking",
      "rankingRequired": true
    },
    {
      "metric": "tracked_sales",
      "authority": "snk_exact_recent_trades",
      "primary": "snk_recent_trades",
      "secondary": ["ebay_psa10_sold"],
      "collector": "pipelines/snk_market_data.py + pending repository-owned eBay sold adapter",
      "collectorTool": "snk-reference-price",
      "bootstrapEvidence": ["grade10_ebay_sale_history"],
      "fallback": [],
      "databaseTarget": "market_daily_sales_aggregate",
      "snapshotFields": ["cards.<id>.windows.1d.trackedSales", "cards.<id>.windows.7d.trackedSales", "cards.<id>.windows.30d.trackedSales", "cards.<id>.historyDaily"],
      "freshnessHours": 30,
      "failureMode": "show_unavailable",
      "rankingRequired": false
    },
    {
      "metric": "price_change_1d_7d_30d",
      "authority": "cardz_daily_reference_price_derivation",
      "primary": "cardz_derived",
      "collector": "pipelines/market_alerts.py",
      "collectorTool": "ranking-alerts",
      "dependsOn": ["psa10_reference_price"],
      "fallback": [],
      "databaseTarget": "market_candidate_daily_snapshot",
      "snapshotFields": ["cards.<id>.windows.1d.changePct", "cards.<id>.windows.7d.changePct", "cards.<id>.windows.30d.changePct"],
      "failureMode": "show_accumulating",
      "rankingRequired": false
    },
    {
      "metric": "psa10_market_cap",
      "authority": "cardz_psa10_market_cap_formula",
      "primary": "cardz_derived",
      "collector": "pipelines/market_alerts.py",
      "collectorTool": "ranking-derivation",
      "dependsOn": ["psa10_population", "psa10_reference_price"],
      "formula": "psa10_population * psa10_reference_price",
      "fallback": [],
      "databaseTarget": "market_candidate_daily_snapshot",
      "snapshotFields": ["cards.<id>.marketCap", "cards.<id>.rank"],
      "failureMode": "exclude_from_ranking",
      "rankingRequired": true
    },
    {
      "metric": "grader_supply_psa_bgs_cgc_sgc_tag",
      "authority": "gemrate",
      "primary": "gemrate",
      "collector": "pipelines/gemrate_source.py daily",
      "collectorTool": "gemrate-population",
      "fallback": [],
      "databaseTarget": "market_grader_population_observation",
      "snapshotFields": ["cards.<id>.graderPopulations"],
      "freshnessHours": 48,
      "failureMode": "show_unavailable",
      "rankingRequired": false,
      "coverageNote": "Per-card TAG remains unavailable until returned by the GemRate card API; grader-level TAG volume is stored separately and never substituted."
    },
    {
      "metric": "card_market_story",
      "authority": "cardz_editorial",
      "primary": "cardz_editorial",
      "collector": "editorial import keyed by canonical printing",
      "collectorTool": "canonical-sync",
      "bootstrapEvidence": ["grade10_summary"],
      "fallback": [],
      "databaseTarget": "card_market_story",
      "snapshotFields": ["cards.<id>.stories"],
      "failureMode": "show_unavailable",
      "rankingRequired": false
    },
    {
      "metric": "fx_usd_display_rates",
      "authority": "frankfurter",
      "primary": "frankfurter",
      "collector": "pipelines/fx_rates.py",
      "collectorTool": "canonical-db",
      "fallback": ["last_good_72h"],
      "databaseTarget": "fx_rate_observation",
      "snapshotFields": ["currencies"],
      "freshnessHours": 36,
      "staleHours": 72,
      "failureMode": "disable_currency_conversion",
      "rankingRequired": false
    }
  ]
}
