{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cardz-market-cap-local",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "upload_source_maps": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/market-assets/*"]
  },
  "r2_buckets": [
    {
      "binding": "MARKET_DATA",
      "bucket_name": "cardz-market-cap-local-data",
      "preview_bucket_name": "cardz-market-cap-local-data"
    }
  ],
  "vars": {
    "CARDZ_ENVIRONMENT": "local",
    "MARKET_DATA_POINTER_KEY": "latest.json",
    "MARKET_DATA_ALLOW_DEMO": "true"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "env": {
    "canary": {
      "name": "cardz-market-cap-canary",
      "workers_dev": true,
      "upload_source_maps": false,
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
        "run_worker_first": ["/market-assets/*"]
      },
      "r2_buckets": [
        {
          "binding": "MARKET_DATA",
          "bucket_name": "cardz-market-cap-staging-data",
          "preview_bucket_name": "cardz-market-cap-staging-data"
        }
      ],
      "vars": {
        "CARDZ_ENVIRONMENT": "canary",
        "MARKET_DATA_POINTER_KEY": "candidate.json",
        "MARKET_DATA_ALLOW_DEMO": "true"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1
      }
    },
    "staging": {
      "name": "cardz-market-cap-staging",
      "workers_dev": true,
      "upload_source_maps": false,
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
        "run_worker_first": ["/market-assets/*"]
      },
      "r2_buckets": [
        {
          "binding": "MARKET_DATA",
          "bucket_name": "cardz-market-cap-staging-data",
          "preview_bucket_name": "cardz-market-cap-staging-data"
        }
      ],
      "vars": {
        "CARDZ_ENVIRONMENT": "staging",
        "MARKET_DATA_POINTER_KEY": "latest.json",
        "MARKET_DATA_ALLOW_DEMO": "true"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1
      }
    },
    "production": {
      "name": "cardz-market-cap-production",
      "workers_dev": false,
      "upload_source_maps": false,
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
        "run_worker_first": ["/market-assets/*"]
      },
      "r2_buckets": [
        {
          "binding": "MARKET_DATA",
          "bucket_name": "cardz-market-cap-production-data",
          "preview_bucket_name": "cardz-market-cap-production-data"
        }
      ],
      "vars": {
        "CARDZ_ENVIRONMENT": "production",
        "MARKET_DATA_POINTER_KEY": "latest.json",
        "MARKET_DATA_ALLOW_DEMO": "false"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1
      }
    }
  }
}
