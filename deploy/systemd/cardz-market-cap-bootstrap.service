[Unit]
Description=Bootstrap CARDZ Market Cap canonical database
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cardz
Group=cardz
WorkingDirectory=/opt/cardz-market-cap
EnvironmentFile=/etc/cardz-market-cap/backend.env
ExecStart=/usr/bin/env bash /opt/cardz-market-cap/scripts/backend.sh bootstrap --external-db --mode production --bootstrap-archive /opt/cardz-market-cap/data/private/cardz-active-bootstrap.tar.gz
TimeoutStartSec=7200
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cardz-market-cap/data/runtime /opt/cardz-market-cap/.venv-backend
