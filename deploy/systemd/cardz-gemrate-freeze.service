[Unit]
Description=CARDZ Market Cap weekly GemRate roster + population freeze
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1d
StartLimitBurst=3
# 同 daily 一樣：unit 層面死法（timeout 殺 process tree、226/NAMESPACE）冇人會叫
# verify，只可以靠 systemd 自己觸發通報。
OnFailure=cardz-market-cap-alert@%n.service
# 全掃唔准同每日出數搶 GemRate quota／DB。daily 行 2–2.5 鐘，Conflicts 保證
# 兩者唔會重疊；後開嗰個會令先開嗰個停。排程時間本身已經隔開咗，呢個係第二道閘。
Conflicts=cardz-market-cap-daily.service

[Service]
Type=oneshot
User=cardz
Group=cardz
WorkingDirectory=/opt/cardz-market-cap
EnvironmentFile=/etc/cardz-market-cap/backend.env
# GemRate key 可以擺 backend.env，亦可以獨立一個檔（`-` = 唔存在都唔算錯）。
# 分開檔嘅好處：key 07-29 到期換新只需要換一個檔，唔使郁 DB 密碼嗰份。
EnvironmentFile=-/etc/cardz-market-cap/gemrate.env
Environment=CARDZ_REPO_ROOT=/opt/cardz-market-cap
Environment=CARDZ_ENV_FILE=/etc/cardz-market-cap/backend.env
Environment=CARDZ_FREEZE_SPEED=medium
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env bash /opt/cardz-market-cap/deploy/systemd/run-cardz-gemrate-freeze.sh
# 4 鐘。實測 medium speed 約 16 張/分鐘，1468 張 ≈ 92 分鐘；留足夠水位俾
# retry／慢 response，但唔好無限期霸住 quota。
TimeoutStartSec=14400
# 唔設 Restart：--resume 令下星期自動接住未掃完嗰啲，唔使即刻重試搶 quota。
# 真係要即刻補跑就 `systemctl start cardz-gemrate-freeze.service`。
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# 比 daily 窄好多：api-dump 只寫 GemRate 私有 cache（cards/ runs/）同 log。
# 唔掂 data/public、manifests、packages/dist —— 全掃唔應該有能力改到出街嘅嘢。
ReadWritePaths=/opt/cardz-market-cap/data/private/gemrate /opt/cardz-market-cap/data/runtime

[Install]
WantedBy=multi-user.target
