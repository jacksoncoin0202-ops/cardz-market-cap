[Unit]
Description=Run CARDZ Market Cap new-era refresh daily at 00:30 UTC

[Timer]
# 00:30 UTC = 09:30 JST。每日只做 active refresh、candidate scan、gap export；
# 不會自動 promote、build 或 deploy。
OnCalendar=*-*-* 00:30:00 UTC
# Never launch a catch-up full refresh when an operator enables/restarts this
# timer after 00:30 UTC; that would collide with an in-progress targeted run.
Persistent=false
AccuracySec=1min
Unit=cardz-market-cap-daily.service

[Install]
WantedBy=timers.target
