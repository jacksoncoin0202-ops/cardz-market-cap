[Unit]
Description=CARDZ broad market index discovery refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cardz
Group=cardz
WorkingDirectory=/opt/cardz-market-cap
ExecStart=/usr/bin/env bash /opt/cardz-market-cap/scripts/backend.sh discovery
TimeoutStartSec=1800
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cardz-market-cap/integrations/grade10/data /opt/cardz-market-cap/data/runtime /opt/cardz-market-cap/.venv-backend

[Install]
WantedBy=multi-user.target
