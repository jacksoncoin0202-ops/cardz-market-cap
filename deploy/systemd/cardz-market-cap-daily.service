[Unit]
Description=CARDZ Market Cap new-era active refresh
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1h
StartLimitBurst=3
OnFailure=cardz-market-cap-alert@%n.service

[Service]
Type=oneshot
User=cardz
Group=cardz
WorkingDirectory=/opt/cardz-market-cap
EnvironmentFile=/etc/cardz-market-cap/backend.env
EnvironmentFile=-/etc/cardz-market-cap/gemrate.env
Environment=CARDZ_REPO_ROOT=/opt/cardz-market-cap
Environment=CARDZ_ENV_FILE=/etc/cardz-market-cap/backend.env
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env bash /opt/cardz-market-cap/deploy/systemd/run-cardz-daily.sh
TimeoutStartSec=21600
Restart=on-failure
RestartSec=10min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cardz-market-cap/data/runtime /opt/cardz-market-cap/data/private/gemrate /opt/cardz-market-cap/data/private/pricecharting_session

[Install]
WantedBy=multi-user.target
