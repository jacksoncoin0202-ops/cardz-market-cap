[Unit]
Description=CARDZ Market Cap canonical daily sync
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
User=cardz
Group=cardz
WorkingDirectory=/opt/cardz-market-cap
EnvironmentFile=/etc/cardz-market-cap/backend.env
Environment=CARDZ_REPO_ROOT=/opt/cardz-market-cap
Environment=CARDZ_ENV_FILE=/etc/cardz-market-cap/backend.env
Environment=CARDZ_DAILY_MODE=production
ExecStart=/usr/bin/env bash /opt/cardz-market-cap/deploy/systemd/run-cardz-daily.sh
TimeoutStartSec=7200
Restart=on-failure
RestartSec=10min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cardz-market-cap/integrations/grade10/data /opt/cardz-market-cap/data/runtime /opt/cardz-market-cap/data/private/gemrate /opt/cardz-market-cap/.venv-backend

[Install]
WantedBy=multi-user.target
