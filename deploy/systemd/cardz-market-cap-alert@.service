[Unit]
# 由其他 unit 嘅 OnFailure=cardz-market-cap-alert@%n.service 觸發，唔好自己 enable。
# %i = 死咗嗰個 unit 嘅全名（例如 cardz-market-cap-daily.service）。
#
# 呢條路專門捉「outcome gate 根本冇機會跑」嗰類死法：TimeoutStartSec 殺成個
# process tree、226/NAMESPACE（ReadWritePaths 有路徑唔存在，死喺 ExecStart 之前）、
# python 未入到 gate 就爆。gate 有跑到嗰啲（exit 1 / 2）由 verify_daily_run.py
# 自己喺 process 入面通報，兩邊共用同一個 dedupe key，一單事故只會出一次聲。
Description=CARDZ failure notification for %i

[Service]
Type=oneshot
User=cardz
Group=cardz
WorkingDirectory=/opt/cardz-market-cap
# CARDZ_ALERT_WEBHOOK 擺喺呢個 root-owned 0600 檔；冇設就淨係寫 alert 檔，唔會 fail。
EnvironmentFile=/etc/cardz-market-cap/backend.env
Environment=CARDZ_REPO_ROOT=/opt/cardz-market-cap
ExecStart=/usr/bin/env bash /opt/cardz-market-cap/deploy/systemd/run-cardz-alert.sh %i
TimeoutStartSec=120
# 刻意唔設 Restart：通報層自己失敗係要留低嘅訊號，重試只會拖住排隊。
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cardz-market-cap/data/runtime
