[Unit]
Description=CARDZ Market Cap WSL web runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cardz
Group=cardz
WorkingDirectory=/opt/cardz-market-cap/apps/web/.next/standalone
Environment=NODE_ENV=production
Environment=CARDZ_RUNTIME=node
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3900
Environment=MARKET_DATA_POINTER_PATH=/opt/cardz-market-cap/data/runtime/publish-staging/latest.json
Environment=MARKET_DATA_STALE_AFTER_SECONDS=172800
ExecStartPre=/usr/bin/test -r /opt/cardz-market-cap/data/runtime/publish-staging/latest.json
ExecStartPre=/usr/bin/test -r /opt/cardz-market-cap/apps/web/.next/standalone/apps/web/server.js
ExecStart=/usr/bin/env node apps/web/server.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
