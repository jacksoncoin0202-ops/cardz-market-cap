[Unit]
Description=Refresh CARDZ broad discovery roster ahead of the daily canonical run

[Timer]
# 呢度用 UTC，唔好寫本地時間。
# 全部 CARDZ timer 一律 UTC（cardz-market-cap-daily.timer 00:30 UTC、
# cardz-market-cap-watchdog.timer 05:07 UTC）。run_daily.py 由 UTC 日期砌
# market_run_id，排程寫本地時區會令本地日同 UTC 日撕裂（2026-07-25 事故）。
#
# 歷史：呢個 timer 原本 05:45 Asia/Tokyo，daily 搬去 00:30 UTC 之後改成
# 23:43 UTC，即 daily 前 47 分鐘。呢個「維持原本前置關係」嘅做法有問題：
# 兩條 timer 都係定死秒數，對外睇落就係「每日 23:43 一炮、47 分鐘後再一炮」
# 嘅固定節奏。docs/HANDOFF.md §8 第 2 條唔准爬取時序照抄固定日程；一對
# 恆定間距嘅出擊時間，同照抄一份日程係同一件事。
#
# 而家：21:17 UTC ± 25 分鐘 = 06:17–06:42 JST。
#   - discovery TimeoutStartSec=1800，最壞情況 22:12 UTC 收工。
#   - daily 最早 00:30 UTC 開跑 → 中間至少隔 2 個鐘 18 分，pre-warm 關係仍然成立。
#   - 兩條 timer 各有 jitter（呢條 1500s、daily 1800s），間距每日喺
#     2h48m–3h43m 之間浮動，冇固定 offset 可以指紋化。
#   - Sunday 撞唔到 cardz-gemrate-freeze（14:23 UTC ± 1h，最長 4 個鐘）。
#
# 分鐘數繼續揀 :17 呢種非整點、非整刻值，避開整點排程尖峰。
# 注意：backend.py daily 自己會再叫一次 run_discovery_tool()，所以呢條 timer
# 係 pre-warm，唔係硬依賴 —— 移時間唔會整爛 daily。
OnCalendar=*-*-* 21:17:00 UTC
Persistent=true
RandomizedDelaySec=1500
Unit=cardz-grade10-discovery.service

[Install]
WantedBy=timers.target
