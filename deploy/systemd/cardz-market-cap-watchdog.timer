[Unit]
Description=Verify the CARDZ daily run actually produced data (05:07 UTC / 14:07 Asia/Tokyo)

[Timer]
# 05:07 UTC = 14:07 JST。daily 由 00:30 UTC 開始，實測跑 2–2.5 小時，
# 即最遲 03:00 UTC 收工；留 2 個鐘水位先至 verify，避免撞正 daily 仲跑緊。
# 錯開分鐘數（:07）唔用 :00，避開整點嘅排程尖峰。
OnCalendar=*-*-* 05:07:00 UTC
Persistent=true
AccuracySec=1min
Unit=cardz-market-cap-watchdog.service

[Install]
WantedBy=timers.target
