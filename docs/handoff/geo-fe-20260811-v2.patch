+  margin: 0;
+  color: var(--fg);
+  font-size: 12px;
+  font-weight: 600;
+}
+.provenance-steps dd {
+  margin: 3px 0 0;
+  color: var(--muted);
+  font-size: 12.5px;
+  line-height: 1.65;
+}
+.provenance-updated {
+  margin: 14px 0 0;
+  color: var(--muted);
+  font-size: 12px;
+  font-variant-numeric: tabular-nums;
+}
+.provenance-byline {
+  margin: 6px 0 0;
+  color: var(--muted);
+  font-size: 12px;
+  opacity: 0.85;
+}
+@media (max-width: 900px) {
+  .provenance-panel { margin-top: 28px; padding: 20px 18px; border-radius: 14px; }
+  .provenance-panel h2 { font-size: 14px; }
