{
  "architecture": {
    "codeIndex": {
      "authority": false,
      "database": ".codegraph/codegraph.db",
      "purpose": "Read-only AST call/import/impact index; never overrides routing, ranking, storage or work-item policy.",
      "tool": "@colbymchenry/codegraph"
    },
    "edges": [
      {
        "from": "discovery.candidates",
        "id": "edge.discovery-authority",
        "relation": "requests_exact_identity_and_population",
        "required": true,
        "to": "authority.gemrate"
      },
      {
        "from": "authority.gemrate",
        "id": "edge.authority-direct",
        "relation": "preferred_transport",
        "required": false,
        "to": "transport.gemrate-direct"
      },
      {
        "from": "authority.gemrate",
        "id": "edge.authority-public",
        "relation": "keyless_exact_transport",
        "required": false,
        "to": "transport.gemrate-public"
      },
      {
        "from": "authority.gemrate",
        "id": "edge.authority-mirror",
        "relation": "current_population_fallback_transport",
        "required": false,
        "to": "transport.gemrate-mirror"
      },
      {
        "from": "transport.gemrate-direct",
        "id": "edge.direct-landing",
        "relation": "writes_receipt",
        "required": false,
        "to": "landing.immutable-receipts"
      },
      {
        "from": "transport.gemrate-public",
        "id": "edge.public-landing",
        "relation": "writes_receipt",
        "required": false,
        "to": "landing.immutable-receipts"
      },
      {
        "from": "transport.gemrate-mirror",
        "id": "edge.mirror-landing",
        "relation": "writes_receipt",
        "required": false,
        "to": "landing.immutable-receipts"
      },
      {
        "from": "landing.immutable-receipts",
        "id": "edge.landing-identity",
        "relation": "normalizes",
        "required": true,
        "to": "normalizer.identity"
      },
      {
        "from": "normalizer.identity",
        "id": "edge.identity-alias",
        "relation": "confirms_exact_alias",
        "required": true,
        "to": "crosswalk.provider-alias"
      },
      {
        "from": "normalizer.identity",
        "id": "edge.identity-review",
        "relation": "quarantines_conflict",
        "required": false,
        "to": "review.identity"
      },
      {
        "from": "crosswalk.provider-alias",
        "id": "edge.alias-snk",
        "relation": "enables_exact_price_lookup",
        "required": true,
        "to": "collector.snk-exact"
      },
      {
        "from": "crosswalk.provider-alias",
        "id": "edge-alias-db",
        "relation": "persists_alias_evidence",
        "required": true,
        "to": "database.canonical"
      },
      {
        "from": "collector.snk-exact",
        "id": "edge-snk-db",
        "relation": "writes_normalized_market_facts",
        "required": true,
        "to": "database.canonical"
      },
      {
        "from": "database.canonical",
        "id": "edge-db-gate",
        "relation": "validates_current_facts",
        "required": true,
        "to": "validator.eligibility"
      },
      {
        "from": "validator.eligibility",
        "id": "edge-gate-derive",
        "relation": "admits_formal_and_radar_bands",
        "required": true,
        "to": "derivation.market"
      },
      {
        "from": "derivation.market",
        "id": "edge-derive-rank",
        "relation": "orders_eligible_market_cap",
        "required": true,
        "to": "ranking.scopes"
      },
      {
        "from": "ranking.scopes",
        "id": "edge-rank-views",
        "relation": "projects_rank_ranges",
        "required": true,
        "to": "export.views"
      },
      {
        "from": "export.views",
        "id": "edge-views-snapshot",
        "relation": "sanitizes_for_frontend",
        "required": true,
        "to": "export.sanitized-snapshot"
      },
      {
        "from": "orchestrator.daily",
        "id": "edge-daily-state",
        "relation": "promotes_only_after_all_gates",
        "required": true,
        "to": "state.last-good"
      },
      {
        "from": "index.codegraph",
        "id": "edge-codegraph-orchestrator",
        "relation": "explains_code_impact_only",
        "required": false,
        "to": "orchestrator.daily"
      }
    ],
    "entrypoint": "config/data-routing.json",
    "nodes": [
      {
        "id": "discovery.candidates",
        "kind": "collector",
        "label": "Candidate discovery and radar",
        "refs": {
          "metricIds": [
            "candidate_identity"
          ],
          "toolIds": [
            "grade10-bootstrap",
            "candidate-gemrate-backfill"
          ]
        }
      },
      {
        "id": "authority.gemrate",
        "kind": "authority",
        "label": "GemRate identity and population authority",
        "refs": {
          "metricIds": [
            "candidate_identity",
            "psa10_population",
            "psa10_population_history",
            "grader_supply_psa_bgs_cgc_sgc_tag"
          ]
        }
      },
      {
        "id": "transport.gemrate-direct",
        "kind": "transport",
        "label": "GemRate direct API",
        "refs": {
          "metricIds": [
            "psa10_population",
            "psa10_population_history"
          ],
          "toolIds": [
            "gemrate-population"
          ]
        }
      },
      {
        "id": "transport.gemrate-public",
        "kind": "transport",
        "label": "GemRate exact public card receipt",
        "refs": {
          "metricIds": [
            "candidate_identity",
            "psa10_population"
          ],
          "toolIds": [
            "candidate-gemrate-backfill"
          ]
        }
      },
      {
        "id": "transport.gemrate-mirror",
        "kind": "transport",
        "label": "Grade10 GemRate current-POP mirror",
        "refs": {
          "metricIds": [
            "psa10_population"
          ],
          "toolIds": [
            "grade10-bootstrap",
            "gemrate-population"
          ]
        }
      },
      {
        "id": "landing.immutable-receipts",
        "kind": "landing",
        "label": "Immutable private receipts and manifests",
        "refs": {
          "profileIds": [
            "full-backfill",
            "daily"
          ]
        }
      },
      {
        "id": "normalizer.identity",
        "kind": "normalizer",
        "label": "Exact canonical printing resolver",
        "refs": {
          "metricIds": [
            "candidate_identity"
          ],
          "toolIds": [
            "exact-crosswalk",
            "canonical-sync"
          ]
        }
      },
      {
        "id": "crosswalk.provider-alias",
        "kind": "normalizer",
        "label": "Provider alias to canonical printing",
        "refs": {
          "databaseTargets": [
            "catalog_source_identity",
            "catalog_provider_identity_alias"
          ],
          "metricIds": [
            "candidate_identity"
          ],
          "toolIds": [
            "candidate-gemrate-backfill",
            "canonical-db"
          ]
        }
      },
      {
        "id": "review.identity",
        "kind": "review_queue",
        "label": "Identity conflict review queue",
        "refs": {
          "databaseTargets": [
            "market_identity_review_queue"
          ],
          "metricIds": [
            "candidate_identity"
          ]
        }
      },
      {
        "id": "collector.snk-exact",
        "kind": "collector",
        "label": "Exact SNK PSA 10 price and trades",
        "refs": {
          "metricIds": [
            "psa10_reference_price",
            "tracked_sales"
          ],
          "toolIds": [
            "snk-exact-refill",
            "snk-reference-price"
          ]
        }
      },
      {
        "id": "database.canonical",
        "kind": "database",
        "label": "Canonical MySQL-compatible facts",
        "refs": {
          "consumerIds": [
            "canonical_mysql"
          ],
          "databaseTargets": [
            "catalog_variant",
            "catalog_source_identity",
            "catalog_provider_identity_alias",
            "market_grader_population_observation",
            "market_price_observation",
            "market_daily_sales_aggregate",
            "market_candidate_daily_snapshot",
            "market_index_snapshot",
            "market_index_constituent"
          ],
          "toolIds": [
            "canonical-db"
          ]
        }
      },
      {
        "id": "validator.eligibility",
        "kind": "validator",
        "label": "POP, identity and price eligibility gate",
        "refs": {
          "metricIds": [
            "candidate_identity",
            "psa10_population",
            "psa10_reference_price",
            "psa10_market_cap"
          ],
          "toolIds": [
            "coverage-audit"
          ]
        }
      },
      {
        "id": "derivation.market",
        "kind": "derivation",
        "label": "Market cap, windows, sales and alerts",
        "refs": {
          "metricIds": [
            "price_change_1d_7d_30d",
            "psa10_market_cap",
            "tracked_sales"
          ],
          "toolIds": [
            "ranking-derivation",
            "ranking-alerts"
          ]
        }
      },
      {
        "id": "ranking.scopes",
        "kind": "derivation",
        "label": "Complete TCG, Pokemon and One Piece rankings",
        "refs": {
          "metricIds": [
            "psa10_market_cap"
          ],
          "toolIds": [
            "ranking-derivation"
          ]
        }
      },
      {
        "id": "export.views",
        "kind": "export",
        "label": "Top 100, 300, 350 and reserve projections",
        "refs": {
          "consumerIds": [
            "sanitized_snapshot"
          ]
        }
      },
      {
        "id": "export.sanitized-snapshot",
        "kind": "export",
        "label": "Provider-safe frontend handshake",
        "refs": {
          "consumerIds": [
            "sanitized_snapshot"
          ],
          "toolIds": [
            "snapshot-export"
          ]
        }
      },
      {
        "id": "orchestrator.daily",
        "kind": "orchestrator",
        "label": "One Python daily control flow",
        "refs": {
          "profileIds": [
            "daily",
            "weekly-candidate-refresh",
            "full-backfill"
          ]
        }
      },
      {
        "id": "state.last-good",
        "kind": "checkpoint",
        "label": "Atomic checkpoint and last-good generation",
        "refs": {
          "profileIds": [
            "daily",
            "export"
          ]
        }
      },
      {
        "id": "index.codegraph",
        "kind": "code_index",
        "label": "Local CodeGraph SQLite index",
        "refs": {}
      }
    ]
  },
  "consumers": [
    {
      "entrypoint": "scripts/backend.py",
      "id": "manual_operator",
      "reads": [
        "profiles",
        "tools",
        "routes"
      ],
      "type": "manual"
    },
    {
      "entrypoint": "tests/test_data_routing.py",
      "id": "automated_tests",
      "reads": [
        "routes",
        "tools",
        "profiles"
      ],
      "type": "test"
    },
    {
      "entrypoint": "pipelines/db_runtime.py",
      "id": "canonical_mysql",
      "reads": [
        "routes",
        "tools",
        "storagePolicy"
      ],
      "type": "database"
    },
    {
      "entrypoint": "pipelines/canonical_public_snapshot.py",
      "id": "sanitized_snapshot",
      "reads": [
        "rankingPolicy",
        "presentationViews",
        "routes"
      ],
      "type": "snapshot"
    }
  ],
  "dataCleaningPolicy": {
    "manualPath": "docs/DATA_CLEANING_RULES.md",
    "rulesPath": "config/data-cleaning-rules.json",
    "schemaPath": "config/data-cleaning-rules.schema.json"
  },
  "manuals": [
    {
      "id": "backend-runbook",
      "path": "docs/RUNBOOK.md",
      "purpose": "operator commands, checkpoint and rollback"
    },
    {
      "id": "data-contract",
      "path": "docs/DATA_CONTRACT.md",
      "purpose": "canonical data and snapshot contract"
    },
    {
      "id": "data-cleaning-rules",
      "path": "docs/DATA_CLEANING_RULES.md",
      "purpose": "raw retention, normalization, canonical fact and derivation rules"
    },
    {
      "id": "frontend-handshake",
      "path": "docs/FRONTEND_HANDSHAKE.md",
      "purpose": "sanitized frontend fields only"
    },
    {
      "id": "aws-handoff",
      "path": "docs/AWS_HANDOFF.md",
      "purpose": "Linux/AWS restore and scheduler handoff"
    },
    {
      "id": "gemrate-source",
      "path": "pipelines/GEMRATE_SOURCE.md",
      "purpose": "GemRate authority and transports"
    },
    {
      "id": "grade10-operator",
      "path": "integrations/grade10/OPERATOR_GUIDE.md",
      "purpose": "Grade10 bootstrap and mirror operation"
    },
    {
      "id": "snk-manual",
      "path": "docs/SNKRDUNK_API_MANUAL.md",
      "purpose": "exact SNK price/history collection"
    }
  ],
  "policyVersion": "cardz-routing-2026-07-24",
  "presentationViews": [
    {
      "description": "Public headline projection of the canonical ranking.",
