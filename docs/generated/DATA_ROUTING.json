      "rankRange": "1-100"
    },
    {
      "description": "Public Top 300 projection of the canonical ranking.",
      "id": "top300",
      "rankRange": "1-300"
    },
    {
      "description": "Operator view containing Top 300 plus reserve50.",
      "id": "top350",
