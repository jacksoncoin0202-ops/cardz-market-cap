    },
    {
      "aliasOf": "top300",
      "description": "Compatibility alias for ranks 1-100 leaders plus ranks 101-300 watch candidates.",
      "id": "top100_plus_200",
      "rankRange": "1-300"
    },
    {
      "description": "Private reserve projection; never emitted in a public snapshot.",
      "id": "reserve50",
      "rankEnd": 350,
      "rankStart": 301
    }
  ],
