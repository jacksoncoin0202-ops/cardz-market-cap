# Store secret values in 1Password and inject them only into the private runner.
GEMRATE_API_KEY=
CARDZ_JLP_MYSQL_DSN=
CARDZ_JLP_PRODUCTION_RUNNER=
CARDZ_PRIVATE_ACQUIRE_SCRIPT=../grade10-scraper/grade10_scraper.py
CARDZ_STAGING_R2_BUCKET=cardz-market-cap-staging-data
CARDZ_PRODUCTION_R2_BUCKET=cardz-market-cap-production-data
# JSON command arrays. The canary must write CARDZ_CANARY_RECEIPT_PATH;
# the promoter must write CARDZ_POINTER_PROMOTION_RECEIPT. The bundled
# promoter is staging-only; production needs a separately owned atomic writer.
CARDZ_GENERATION_CANARY_COMMAND_JSON=["node","pipelines/run-generation-canary.mjs"]
CARDZ_POINTER_PROMOTE_COMMAND_JSON=["node","pipelines/promote-staging-pointer.mjs"]
CARDZ_PUBLIC_BUILD_ID=local
CARDZ_CANARY_ORIGIN=
CARDZ_EXPECTED_BUILD_ID=
CARDZ_EXPECTED_GENERATION=
