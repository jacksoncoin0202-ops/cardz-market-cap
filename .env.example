# Store secret values in 1Password and inject them only into the private runner.
GEMRATE_API_KEY=
CARDZ_DB_HOST=127.0.0.1
CARDZ_DB_PORT=3308
CARDZ_DB_NAME=cardz_market_cap
CARDZ_DB_USER=cardz
CARDZ_DB_PASSWORD=
CARDZ_DB_ROOT_PASSWORD=
# Set to external on AWS/RDS so the portable Python runner skips Docker Compose.
CARDZ_DB_MODE=
# Required for production mode with RDS or another externally managed MySQL.
CARDZ_DB_SSL_CA=
CARDZ_PRIVATE_ACQUIRE_SCRIPT=integrations/grade10/run_service.py
# Optional non-secret override for a compatible self-hosted FX service.
CARDZ_FX_ENDPOINT=https://api.frankfurter.dev/v2/rates
CARDZ_STAGING_R2_BUCKET=cardz-market-cap-staging-data
CARDZ_PRODUCTION_R2_BUCKET=cardz-market-cap-production-data
# JSON command arrays. The canary must write CARDZ_CANARY_RECEIPT_PATH;
# the promoter must write CARDZ_POINTER_PROMOTION_RECEIPT. The bundled
# promoter is staging-only; production needs a separately owned atomic writer.
CARDZ_GENERATION_CANARY_COMMAND_JSON=["node","pipelines/run-generation-canary.mjs"]
CARDZ_POINTER_PROMOTE_COMMAND_JSON=["node","pipelines/promote-staging-pointer.mjs"]
CARDZ_PUBLIC_BUILD_ID=local
CARDZ_CANARY_ORIGIN=
CARDZ_EXPECTED_BUILD_ID=
CARDZ_EXPECTED_GENERATION=
# Optional. When set, daily/watchdog failures are POSTed here as JSON.
# Unset = alert file + failed unit only (nothing is sent, nothing fails).
# Never commit a real URL: this file is the example, the real value lives in
# /etc/cardz-market-cap/backend.env (root-owned, 0600).
CARDZ_ALERT_WEBHOOK=
# Optional. Re-send an unchanged, still-failing alert every N days. Default 3.
CARDZ_ALERT_REPEAT_DAYS=
